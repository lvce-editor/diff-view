{
  "name": "build",
  "version": "0.0.0-dev",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build:watch": "esbuild --format=esm --bundle --external:node:buffer --external:electron --external:ws --external:node:worker_threads --watch ../diff-view/src/diffViewWorkerMain.ts --outfile=../../.tmp/dist/dist/diffViewWorkerMain.js",
    "create:e2e-tests": "node --experimental-strip-types src/createE2ETests.ts",
    "measure": "node --experimental-strip-types src/measureMemory.ts",
    "measure:visible": "node --experimental-strip-types src/measureMemory.ts --no-headless",
    "trigger-ci-branches": "bash ./trigger-ci-branches.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@lvce-editor/verror": "^1.7.0",
    "@lvce-editor/measure-memory": "^3.11.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^22.13.14",
    "esbuild": "^0.28.2",
    "execa": "^10.0.1",
    "rollup": "^4.38.0"
  }
}
