{
  "name": "e2e",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "e2e": "npm run e2e:prepare && test-with-playwright --only-extension=. --test-path=. --reuse-page",
    "e2e:firefox": "npm run e2e:prepare && test-with-playwright --only-extension=. --test-path=. --browser=firefox --reuse-page",
    "e2e:firefox:headless": "npm run e2e:prepare && test-with-playwright --only-extension=. --test-path=. --browser=firefox --headless --reuse-page",
    "e2e:headless": "npm run e2e:prepare && test-with-playwright --only-extension=. --test-path=. --headless --reuse-page",
    "e2e:prepare": "node ./scripts/prepare-extension.js",
    "e2e:webkit": "npm run e2e:prepare && test-with-playwright --only-extension=. --test-path=. --browser=webkit --reuse-page",
    "e2e:webkit:headless": "npm run e2e:prepare && test-with-playwright --only-extension=. --test-path=. --browser=webkit --headless --reuse-page",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@lvce-editor/api": "^8.84.0",
    "@lvce-editor/test-with-playwright": "^22.29.0",
    "esbuild": "^0.28.2"
  }
}
